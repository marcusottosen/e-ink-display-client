# Docker host URL. Keep this as the host application URL, not a Docker API URL.
INKY_AGENT_SERVER_URL=http://192.168.0.101:8000
INKY_AGENT_DISPLAY_ID=inky-main
# Leave empty while host authentication is disabled. Set only when enabled on the host.
INKY_AGENT_DEVICE_TOKEN=
INKY_AGENT_DATA_DIR=/var/lib/inky-agent
INKY_AGENT_POLL_INTERVAL_SECONDS=10
INKY_AGENT_HEARTBEAT_INTERVAL_SECONDS=60
INKY_AGENT_REQUEST_TIMEOUT_SECONDS=30
INKY_AGENT_RETRY_INITIAL_SECONDS=2
INKY_AGENT_RETRY_MAX_SECONDS=60
INKY_AGENT_HARDWARE_ENABLED=true
